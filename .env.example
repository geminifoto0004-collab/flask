# ========== Flask ?蔭 ==========
# Flask 撖嚗??身蝵殷??冽 session ??嚗?# ???寞?嚗ython -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-to-random-string

# ========== 頞?蝞∠??⊿?蝵?==========
# ?? 敹?閮剔蔭嚗?閬蝙?券?隤潘?
SUPER_ADMIN_EMAIL=admin@xingwang.com
SUPER_ADMIN_PASSWORD=your_secure_password_here

# ========== SMTP ?萎辣?蔭 ==========
# Gmail SMTP ?蔭嚗???閬?隞塚?
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=your-app-password

# ========== 鞈?摨恍?蝵?==========
# ?賊? 1嚗QLite嚗?圈??潘?
DATABASE_TYPE=sqlite
DATABASE_PATH=./databases/app.db

# ?賊? 2嚗ostgreSQL嚗ender嚗?# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@host:port/database

# ?賊? 3嚗ySQL/TiDB嚗iDB Cloud嚗?# DATABASE_TYPE=tidb
# DB_HOST=xxx.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_username
# DB_PASSWORD=your_password
# DB_NAME=your_database

# ?蝙??DATABASE_URL嚗???SSL ?嚗?# DATABASE_URL=mysql://user:password@host:port/database?ssl_mode=REQUIRED


# ========== TiDB1 / TiDB2 ORDER high availability ==========
# Existing DB_* / MYSQL_* / DATABASE_URL remains TIDB1-compatible.
# DB_TARGET may be TIDB1, TIDB2, or AUTO.
# DB_TARGET=TIDB1
# TIDB_MIRROR_ENABLED=1
# TIDB_FAILOVER_ENABLED=1
# Optional explicit TIDB1 aliases:
# TIDB1_HOST=xxx.tidbcloud.com
# TIDB1_PORT=4000
# TIDB1_USER=your_username
# TIDB1_PASSWORD=your_password
# TIDB1_NAME=your_database
# TIDB1_URL=mysql://user:password@host:4000/database?ssl_mode=REQUIRED
# Standby TiDB2:
# TIDB2_HOST=xxx.tidbcloud.com
# TIDB2_PORT=4000
# TIDB2_USER=your_username
# TIDB2_PASSWORD=your_password
# TIDB2_NAME=your_database
# TIDB2_URL=mysql://user:password@host:4000/database?ssl_mode=REQUIRED
# ORDER_TIDB_DATABASE=order_tracking
