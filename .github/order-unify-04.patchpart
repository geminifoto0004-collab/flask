+    .stage-filters .home-toolbar-actions .customer-search-box {
+        flex: 0 1 180px;
+        width: clamp(120px, 11vw, 200px);
+        min-width: 120px !important;
+        max-width: 200px !important;
+        margin-left: 0 !important;
+    }
+    .stage-filters .home-toolbar-actions .home-view-switch,
+    .stage-filters .home-toolbar-actions .btn.btn-secondary.icon-only { flex: 0 0 auto; }
+}
+@media (min-width: 769px) and (max-width: 1400px) {
+    .stage-filters { gap: .28rem; }
+    .stage-filters .stage-btn {
+        padding-left: .55rem;
+        padding-right: .55rem;
+        gap: .25rem;
+        font-size: .79rem;
+    }
+    .stage-filters .stage-count { padding-left: .28rem; padding-right: .28rem; }
+    .stage-filters .home-toolbar-actions { gap: .3rem; }
+    .stage-filters .home-toolbar-actions .customer-search-box {
+        flex-basis: 135px;
+        width: 135px;
+        min-width: 105px !important;
+        max-width: 150px !important;
+    }
+}
