+function wsGetDepositBalance(orderNumber) {
+    if (!orderNumber) return null;
+    const digits = String(orderNumber).replace(/\D/g, '');
+    if (!digits) return null;
+    const key6 = ('000000' + digits).slice(-6);
+    const balance = wsDepositMap[key6];
+    if (balance === undefined || balance === null) return null;
+    const numeric = Number(balance);
+    if (!Number.isFinite(numeric) || Math.abs(numeric) < 0.01) return null;
+    return numeric;
