+        // If either detail UI is already open, refresh its badge after the async map arrives.
+        const wsOrder = document.getElementById('wsOrderNumber')?.textContent?.trim();
+        if (wsOrder && wsOrder !== '-') wsShowDepositBadge(wsOrder);
+        if (homeCardFocusState?.orderNumber) wsShowHomeCardDepositBadge(homeCardFocusState.orderNumber);
+    } catch (e) {
+        // Expected on the China-only standalone ORDER build where COSTO_LABORAL is intentionally absent.
+        console.log('[Deposit] 無法載入訂金資料');
+    }
+}
+
+// Old WORKSPACE drawer badge.
+function wsShowDepositBadge(orderNumber) {
+    wsPaintDepositBadge(
+        document.getElementById('wsDepositBadge'),
+        document.getElementById('wsDepositAmount'),
+        orderNumber
+    );
+}
+
+// New desktop card/modal badge.
+function wsShowHomeCardDepositBadge(orderNumber) {
+    wsPaintDepositBadge(
+        document.getElementById('homeCardFocusDepositBadge'),
+        document.getElementById('homeCardFocusDepositAmount'),
+        orderNumber
+    );
+}
+
+function wsOpenDepositDetail(orderNumber = '') {
+    let orderNum = String(orderNumber || '').trim();
+    if (!orderNum) {
+        orderNum = document.getElementById('wsOrderNumber')?.textContent?.trim() || '';
+    }
+    if (!orderNum || orderNum === '-' || orderNum === '—') return;
     window.open('/costo_laboral/deposit?nota=' + encodeURIComponent(orderNum), '_blank');
 }
 
+function wsOpenHomeCardDepositDetail() {
+    const orderNum = String(homeCardFocusState?.orderNumber || '').trim();
+    if (!orderNum) return;
+    wsOpenDepositDetail(orderNum);
+}
+
 // 頁面載入時執行
 document.addEventListener('DOMContentLoaded', function () {
     wsLoadDepositMap();
+
+    const homeDepositBadge = document.getElementById('homeCardFocusDepositBadge');
+    if (homeDepositBadge) {
+        homeDepositBadge.addEventListener('click', function (event) {
+            event.preventDefault();
+            event.stopPropagation();
+            wsOpenHomeCardDepositDetail();
+        });
+    }
 });
 
 
